{
  "name": "opencode-oidc-plugin",
  "version": "0.0.0-development",
  "description": "Generic OIDC/PKCE browser-login auth plugin for opencode v2 custom model providers",
  "type": "module",
  "license": "MIT",
  "author": "Hauke Mettendorf",
  "repository": {
    "type": "git",
    "url": "https://github.com/hauke-cloud/opencode-oidc-plugin"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "oauth2",
    "oidc",
    "pkce"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.11",
    "@types/node": "^26.6.1",
    "typescript": "7.0.2"
  }
}
